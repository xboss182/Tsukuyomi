# Apple ID and App-Specific Password for Notarization
# Required for running build:electron locally if you want to notarize
APPLE_ID=your_email@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Certificate Path and Password for Signing
# Optional: Electron Builder automatically finds "Developer ID Application" certs in your Keychain.
# Uncomment and use these ONLY if you need to override Keychain auto-discovery or use a file directly.
# CSC_LINK=/path/to/certificate.p12
# CSC_KEY_PASSWORD=your_password

# Private web deployment (copy to protected runtime.env; never commit real values)
# HOST=127.0.0.1
# PORT=3010
# TSUKUYOMI_ORIGIN=https://novel.shieldme.cc
# TSUKUYOMI_DATABASE_PATH=/var/lib/tsukuyomi/app.sqlite3
# TSUKUYOMI_DATA_KEY=<base64-encoded-32-byte-key>
# TSUKUYOMI_COMMIT=<deployed-git-sha>
# TSUKUYOMI_BACKUP_PATH=/var/backups/tsukuyomi/app.sqlite3
